# Server Port (Auto-assigned by Render/Railway/Heroku if omitted)
PORT=5000

# Environment Mode
NODE_ENV=production

# JWT Authentication Secret Key (Required: Replace with a secure random 32+ character string)
JWT_SECRET=speakwise_production_secret_jwt_key_replace_this

# Persistent SQLite Database Path (Optional: defaults to server/data/speakwise.db)
# On Render/Railway with Persistent Disk mounted at /var/data, set to: /var/data/speakwise.db
DATABASE_PATH=

# Allowed CORS Origins (Optional: comma-separated list of domains or '*' for all)
CORS_ORIGIN=*

# Optional: Google Gemini API Key for online generative AI responses
# When omitted, SpeakWise AI uses its built-in offline NLP intent-based tutor
AI_API_KEY=
